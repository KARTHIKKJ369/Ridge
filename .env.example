# ==============================================================================
# Ridge 2.0: Corrective RAG (CRAG) Environment Configuration Template
# ==============================================================================

# Environment mode ('development' or 'production')
ENV=development

# LLM Provider Selection ('groq' or 'gemini')
LLM_PROVIDER=groq

# Google AI Studio API Key (for Gemini 1.5 Flash, 2.0 Flash, 1.5 Pro)
# Get a free API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# Groq Cloud API Key (Primary Provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# HuggingFace Local Embedding Model (Runs locally with Apple Silicon MPS/Metal or CUDA acceleration)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024

# PostgreSQL + pgvector System of Record & Vector Store
DATABASE_URL=postgresql+asyncpg://ridge:ridge@localhost:5433/ridge
DATABASE_URL_SYNC=postgresql://ridge:ridge@localhost:5433/ridge
RETRIEVAL_BACKEND=pgvector

# Data Storage
DATA_DIR=./data

# ==============================================================================
# Retrieval and Re-ranking Configuration
# ==============================================================================
# Re-ranker Backend Selection ('flashrank' or 'cross_encoder')
RERANKER_BACKEND=flashrank

# FlashRank cross-encoder model (e.g. ms-marco-MiniLM-L-12-v2, ms-marco-TinyBERT-L-2-v2, bge-reranker-large)
RERANK_MODEL=ms-marco-MiniLM-L-12-v2

# Sentence-Transformers CrossEncoder model (if RERANKER_BACKEND=cross_encoder)
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Number of top passages to keep after cross-encoder re-ranking
RETRIEVER_K=6
# Number of candidate chunks to initially retrieve from pgvector with hybrid search
RETRIEVER_FETCH_K=60
# Number of candidates sent to cross-encoder reranker
RERANK_TOP_N=20
# Maximal Marginal Relevance diversity weight (0 = pure diversity, 1 = pure relevance)
RETRIEVER_LAMBDA_MULT=0.5

# Grading & Generation Context Limits
GRADE_DOC_LIMIT=4
MAX_CONTEXT_DOCS=6
MAX_CONTEXT_CHARS=1200

# Maximum Query Rewrite Loops before triggering Web Search Fallback
MAX_REWRITE_LOOPS=1

# ==============================================================================
# Security & Upload Configuration
# ==============================================================================
# Allowed CORS Origins (comma-separated, e.g. https://my-frontend.com,http://localhost:5173)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000

# Maximum file upload size in megabytes
MAX_UPLOAD_MB=50

# PyTorch CPU Optimization
TORCH_THREADS=2
TORCH_INTEROP_THREADS=2

# ==============================================================================
# Authentication & JWT Security (PostgreSQL Stored Accounts)
# ==============================================================================
AUTH_ENABLED=true
# In production (Railway, Render, Fly.io), set ENV=production and provide a strong random secret:
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_DAYS=30
BASE_URL=http://localhost:8000

# ==============================================================================
# Observability & Tracing (Langfuse)
# ==============================================================================
# Optional: Set Langfuse credentials for LLM prompt, token, latency & cost tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
