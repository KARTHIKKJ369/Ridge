# ==============================================================================
# Ridge 2.0: Corrective RAG (CRAG) Environment Configuration
# ==============================================================================

# Environment mode ('development' or 'production')
ENV=development

# Required: Groq Cloud API Key for Hallucination Grading, Query Rewriting, and Synthesis
GROQ_API_KEY=gsk_your_groq_api_key_here

# Primary synthesis model and fast evaluator/reformulation model
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# HuggingFace Local Embedding Model (Runs locally with Apple Silicon MPS/Metal or CUDA acceleration)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB Local Persistence Directory (Ignored when CHROMA_CLOUD_HOST is set)
CHROMA_DIR=./chroma_db

# Chroma Cloud (Optional — un-comment to use managed Chroma Cloud instead of local disk)
# CHROMA_CLOUD_HOST=api.trychroma.com
# CHROMA_CLOUD_PORT=8000
# CHROMA_CLOUD_TOKEN=your_chroma_token
# CHROMA_COLLECTION_NAME=ridge_kb

# Data and SQLite Storage
DATA_DIR=./data
PARENT_STORE_DB_PATH=./data/parent_store.db

# Retrieval and Re-ranking Configuration
# FlashRank cross-encoder model (e.g. ms-marco-MiniLM-L-12-v2, ms-marco-TinyBERT-L-2-v2, bge-reranker-large)
RERANK_MODEL=ms-marco-MiniLM-L-12-v2
# Number of top passages to keep after FlashRank cross-encoder re-ranking
RETRIEVER_K=6
# Number of candidate chunks to initially retrieve from ChromaDB with MMR
RETRIEVER_FETCH_K=60
# Number of candidates sent to FlashRank cross-encoder
RERANK_TOP_N=20
# Maximal Marginal Relevance diversity weight (0 = pure diversity, 1 = pure relevance)
RETRIEVER_LAMBDA_MULT=0.5

# Grading & Generation Context Limits
GRADE_DOC_LIMIT=4
MAX_CONTEXT_DOCS=6
MAX_CONTEXT_CHARS=1200

# Maximum Query Rewrite Loops before triggering Web Search Fallback
MAX_REWRITE_LOOPS=1

# ==============================================================================
# Security & Upload Configuration
# ==============================================================================
# Allowed CORS Origins (comma-separated, e.g. https://my-frontend.com,http://localhost:5173)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000

# Maximum file upload size in megabytes
MAX_UPLOAD_MB=50

# ==============================================================================
# Authentication & JWT Security (Local ID + Password Accounts)
# ==============================================================================
AUTH_ENABLED=true
# In production (Railway, Render, Fly.io), set ENV=production and provide a strong random secret:
# Generate with: openssl rand -hex 32
JWT_SECRET=e2eb3dc152cb4185a5089016c21b6fe7ee8b0325f668140991d3e7841fb8c1ab
JWT_EXPIRES_DAYS=7
AUTH_DB_PATH=./users.db
BASE_URL=http://localhost:8000

